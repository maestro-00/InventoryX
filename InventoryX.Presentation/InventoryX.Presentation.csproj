<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>aeaa7cf3-4b4a-45e9-bf11-6db06c0a2cd1</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryX.Application\InventoryX.Application.csproj" />
    <ProjectReference Include="..\InventoryX.Domain\InventoryX.Domain.csproj" />
    <ProjectReference Include="..\InventoryX.Infrastructure\InventoryX.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy Application XML docs so Swagger IncludeXmlComments can find them at runtime. -->
  <Target Name="CopyApplicationXmlDocs" AfterTargets="Build">
    <Copy
      SourceFiles="$(ProjectDir)..\InventoryX.Application\bin\$(Configuration)\$(TargetFramework)\InventoryX.Application.xml"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(ProjectDir)..\InventoryX.Application\bin\$(Configuration)\$(TargetFramework)\InventoryX.Application.xml')" />
  </Target>

</Project>
