{
  "ConnectionStrings": {
    "DefaultConnection": "=== YOUR CONNECTION STRING ==="
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    }
  },
  "SendGridKey": "YOUR SENDGRID KEY",
  "SenderName": "NAME OF SENDGRID SENDER",
  "SenderEmail": "EMAIL OF SENDGRID SENDER",
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://127.0.0.1:5173",
      "https://127.0.0.1:5173",
      "http://localhost:8080",
      "https://localhost:8080",
      "http://localhost:3000",
      "https://localhost:3000"
    ],
    "EmailVerificationUrl": "http://localhost:8080/auth/verify-email",
    "ResetPasswordUrl": "http://localhost:8080/auth/reset-password"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "InventoryX",
    "Audience": "InventoryX.Api",
    "SigningKey":"=== Your Signing Key ===",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 10,
    "RegisterTokenMinutes": 720
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
